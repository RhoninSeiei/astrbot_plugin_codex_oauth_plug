{
  "usage": {
    "description": "额度查询工具",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用额度查询工具",
        "type": "bool",
        "default": true
      },
      "provider_id": {
        "description": "额度查询目标提供商",
        "type": "string",
        "hint": "填写已有 Codex OAuth 模型提供商 ID。配置后任何聊天模型都可调用额度工具，斜杠命令也无需聊天模型。留空时使用当前会话提供商。",
        "default": ""
      },
      "group_allowlist": {
        "description": "允许查询的群会话",
        "type": "list",
        "hint": "填写完整 unified_msg_origin。默认只允许管理员私聊；群聊也必须由管理员查询。",
        "default": []
      }
    }
  },
  "runtime": {
    "description": "运行设置",
    "type": "object",
    "hint": "首次使用只需检查代理和模型列表，然后按 README 执行管理员授权命令。OAuth 凭据会自动填写。",
    "items": {
      "tools_only": {
        "description": "仅额度工具模式",
        "type": "bool",
        "hint": "使用内置 OAuth 时开启。仅提供额度工具，不注册插件提供商和授权接口；修改后重载生效。",
        "default": false
      },
      "enabled": {
        "description": "启用插件提供商",
        "type": "bool",
        "default": true
      },
      "base_url": {
        "description": "Codex backend 地址",
        "type": "string",
        "default": "https://chatgpt.com/backend-api/codex"
      },
      "proxy": {
        "description": "HTTP 代理",
        "type": "string",
        "hint": "可直接连接时留空。Docker 中 127.0.0.1 指容器自身，请填写容器能够访问的 HTTP 代理地址。",
        "default": ""
      },
      "models": {
        "description": "手动补充模型列表",
        "type": "text",
        "hint": "每行一个模型 ID，首行保持为连接测试默认模型；开启自动获取后无需手动补录新模型。",
        "default": "gpt-5.6-sol\ngpt-6.1-sol\ngpt-6.1-terra\ngpt-6-astra\ngpt-6-sol\ngpt-6-luna\ngpt-5.6-terra\ngpt-5.6-luna"
      },
      "oauth_refresh_skew_seconds": {
        "description": "提前刷新秒数",
        "type": "int",
        "default": 300
      },
      "auto_models": {
        "description": "自动获取模型列表",
        "type": "bool",
        "default": true,
        "hint": "已绑定账号时从 Codex 获取模型目录，与手动列表合并。失败时保留手动列表；发现结果缓存 5 分钟。"
      }
    }
  },
  "oauth": {
    "description": "OAuth 凭据",
    "type": "object",
    "hint": "由 codex_oauth_start 和 codex_oauth_complete 自动管理，通常无需手动编辑。不要公开这些字段或包含字段值的截图。",
    "items": {
      "auth_mode": {
        "description": "认证模式",
        "type": "string",
        "default": "manual"
      },
      "oauth_provider": {
        "description": "授权服务",
        "type": "string",
        "default": ""
      },
      "oauth_access_token": {
        "description": "访问令牌 Access token",
        "type": "text",
        "default": ""
      },
      "oauth_refresh_token": {
        "description": "刷新令牌 Refresh token",
        "type": "text",
        "default": ""
      },
      "oauth_expires_at": {
        "description": "授权过期时间",
        "type": "string",
        "default": ""
      },
      "oauth_account_id": {
        "description": "ChatGPT 账号 ID",
        "type": "string",
        "default": ""
      }
    }
  },
  "advanced": {
    "description": "高级设置",
    "type": "object",
    "items": {
      "generated_image_dir": {
        "description": "生图保存目录",
        "type": "string",
        "hint": "留空时保存到 AstrBot data/generated/openai_oauth_images。",
        "default": ""
      },
      "oauth_web_search": {
        "description": "联网搜索模式",
        "type": "string",
        "options": [
          "disabled",
          "cached",
          "live"
        ],
        "default": "disabled",
        "hint": "disabled 关闭；cached 使用缓存；live 允许实时网页访问。"
      },
      "oauth_web_search_domains": {
        "description": "允许搜索的域名",
        "type": "list",
        "default": [],
        "hint": "留空不限域名。填写 example.com，不要填写完整 URL。"
      },
      "oauth_audio_transcription": {
        "description": "自动转录聊天音频",
        "type": "bool",
        "default": false,
        "hint": "默认关闭。账号具备音频转录权限时才能启用；否则请配置 AstrBot STT。"
      },
      "oauth_transcription_model": {
        "description": "音频转录模型",
        "type": "string",
        "default": "gpt-4o-transcribe"
      },
      "oauth_image_model": {
        "description": "实验性图片模型",
        "type": "string",
        "default": "gpt-image-2.6-sunburst",
        "options": [
          "gpt-image-2.6-sunburst",
          "gpt-image-2.6-flare",
          "gpt-image-2.5-sunburst",
          "gpt-image-2.5-flare",
          "gpt-image-2",
          ""
        ],
        "hint": "默认请求 Images 2.6 Sunburst；其他插件可在单次调用覆盖。该字段不改变主控聊天模型，后端未回报实际图像模型，不能保证选择生效。"
      }
    }
  }
}
